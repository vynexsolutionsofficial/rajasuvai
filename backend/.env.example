PORT=3001

# --- SUPABASE ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- EMAIL NOTIFICATIONS (Nodemailer) ---
# Use a Gmail App Password from Google Account > Security > 2-Step Verification
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- RAZORPAY GATEWAY ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required only if using the /api/payments/webhook endpoint; without it the
# webhook handler rejects all requests instead of falling back to a default.
RAZORPAY_WEBHOOK_SECRET=
